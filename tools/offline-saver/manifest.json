{
  "manifest_version": 3,
  "name": "Guardar Offline",
  "version": "1.3.0",
  "description": "Guarda la página actual como un único archivo HTML offline con imágenes, estilos, fuentes y datos embebidos.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs", "webNavigation", "debugger", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icons/icon128.png" } },
  "icons": { "128": "icons/icon128.png" }
}
